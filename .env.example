# --- AdGuard Home ---
# Instancia principal: se consulta y recibe las excepciones.
# Primary instance: queried and receives the exceptions.
ADGUARD_URL=http://192.168.1.2
# Réplicas opcionales, separadas por coma (solo se lee su registro).
# Optional replicas, comma-separated (only their query log is read).
ADGUARD_EXTRA_URLS=
ADGUARD_USERNAME=usuario
ADGUARD_PASSWORD=cambiar

# --- Acceso / Access (uno o ambos / one or both) ---
APP_USERNAME=admin
APP_PASSWORD=cambiar-por-una-larga

# OIDC opcional (PocketID, Authentik, Keycloak...). Sin secreto = cliente público con PKCE.
# Optional OIDC. No secret = public client with PKCE.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=PocketID
# Solo estos usuarios (preferred_username o email), separados por coma.
# Only these users (preferred_username or email), comma-separated.
OIDC_ALLOWED_USERS=

# --- Varios / Misc ---
# python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# URL pública del portal (la usa el botón de la página de bloqueo).
# Public portal URL (used by the block page button).
ADMIN_URL=https://portal.example.com
APP_PORT=8090
SITE_TITLE=AdGuard Home Portal
# Idioma si el navegador no es español ni inglés / Fallback language: es | en
DEFAULT_LANG=es
# false solo si entrás por http sin proxy / false only for plain http without a proxy
COOKIE_SECURE=true
# Zona horaria de las fechas de las excepciones / Time zone for exception dates
TZ=America/Montevideo
